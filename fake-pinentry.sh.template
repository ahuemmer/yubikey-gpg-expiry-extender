#Header and vars will be filled in above:
#!/bin/bash
#keyPassphrase=...
#masterKeyId=...
#cardNumber=...
#adminPin=...

FAKE_PINENTRY_LOGFILE=/tmp/fake-pinentry.log

echo "GNUPGHOME=${GNUPGHOME}" >> ${FAKE_PINENTRY_LOGFILE}

write() {
  echo "$(date +%Y%m%d_%H%M%S) ANSWER: $*" >> ${FAKE_PINENTRY_LOGFILE}
  echo $*
}

pin=

echo "OK WARNING! Do NEVER use this in real production environments..."
while read cmd rest; do
  echo "$(date +%Y%m%d_%H%M%S) CMD: $cmd | Rest: $rest" >> ${FAKE_PINENTRY_LOGFILE}
  cmd=$(printf "%s" "$cmd" | tr 'A-Z' 'a-z')
  if [[ -z "${cmd}" ]]; then
    continue
  fi
  case "$cmd" in
    \#*)
      #Comment line...
      ;;
    setkeyinfo)
      keyinfo=${rest}
      write "OK"
      ;;
    setdesc)
      if [[ ${rest} == *${masterKeyId}* ]] || [[ "${rest}" == ^.*[Pp]assphrase.*$ ]]; then
        pin=${keyPassphrase}
        echo "--> Answering with key passphrase on next getpin call." >> ${FAKE_PINENTRY_LOGFILE}
      fi
      if [[ ${rest// /} == *${cardNumber}* ]]; then
        pin=${adminPin}
        echo "--> Answering with YubiKey Admin PIN on next getpin call." >> ${FAKE_PINENTRY_LOGFILE}
      fi
      write "OK"
      ;;
    getpin)
      write "D ${pin}"
      write "OK"
      ;;
    bye)
      write "OK"
      echo "$(date +%Y%m%d_%H%M%S) Exiting" >> ${FAKE_PINENTRY_LOGFILE}
      echo >> ${FAKE_PINENTRY_LOGFILE}
      exit 0
      ;;
    *)
      write "OK"
      ;;
  esac
done
